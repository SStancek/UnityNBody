# ==============================================================================
# Git Attributes for Unity & HLSL Compute Projects
# ==============================================================================

# Set default text behavior to LF normalization
* text=auto

# Code and text files - enforce LF on checkout/commit
*.cs text diff=csharp eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf

# Unity YAML text files
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text merge=unityyamlmerge eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.hdr binary
*.exr binary
*.mesh binary
*.anim binary
*.dll binary
*.exe binary
